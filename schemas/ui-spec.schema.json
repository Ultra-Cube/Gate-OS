{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate-os.ucubetech.com/schemas/ui-spec.v1.json",
  "title": "Gate-OS Native UI Spec",
  "type": "object",
  "required": ["schemaVersion", "id", "layout", "tiles"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "gateos.ui.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "title": {"type": "string", "maxLength": 120},
    "layout": {"type": "string", "enum": ["dashboard", "list", "focus"]},
    "theme": {"type": "string", "enum": ["system", "light", "dark", "high-contrast"]},
    "tiles": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "required": ["id", "component"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]{2,64}$"},
          "component": {"type": "string", "enum": ["text", "metric", "list", "calendar", "status"]},
          "label": {"type": "string", "maxLength": 120},
          "dataBinding": {"type": "string", "pattern": "^[a-z0-9_.-]{1,120}$"},
          "actions": {"type": "array", "items": {"type": "string", "enum": ["refresh", "open", "approve", "dismiss"]}}
        }
      }
    }
  }
}
