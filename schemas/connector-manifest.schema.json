{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate-os.ucubetech.com/schemas/connector-manifest.v1.json",
  "title": "Gate-OS Connector Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "provider", "scopes", "privacyClass"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "gateos.connector.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
    "provider": {"type": "string", "maxLength": 120},
    "authMethod": {"type": "string", "enum": ["none", "oauth2", "oidc", "local"]},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "pattern": "^[a-z0-9_:.-]{1,80}$"}},
    "privacyClass": {"type": "string", "enum": ["public", "personal", "sensitive"]},
    "rateLimit": {"type": "string", "maxLength": 80},
    "signature": {"type": "object", "required": ["algorithm", "keyId", "payloadDigest"], "additionalProperties": false, "properties": {"algorithm": {"const": "ed25519"}, "keyId": {"type": "string"}, "payloadDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
  }
}
