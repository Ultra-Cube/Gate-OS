{
  "name": "Gate-OS development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "GitHub.copilot-chat"]
    }
  },
  "containerEnv": {"GATEOS_CONTAINER_DRY_RUN": "1"},
  "remoteUser": "vscode",
  "runArgs": [],
  "mounts": []
}
